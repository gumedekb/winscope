# ---------------------------------------------------------------------------
# WinScope ETL — API keys.  Copy to `.env` (which is gitignored) and fill in.
# Real environment variables always win over this file, so GitHub Actions
# secrets override it with no code change.
#
# EVERY provider below is capped to 90% of its free tier by apis/ratelimit.py.
# Usage is persisted in output/.quota.json, so all runs in a day share ONE
# budget. Check it any time with:  python pipeline.py --quota
# ---------------------------------------------------------------------------

# API-Football v3 — https://v3.football.api-sports.io   (dashboard: dashboard.api-football.com)
# Free tier: 100 requests/day, 10/minute  ->  we stop at 90/day, 9/minute.
# This is the one to be careful with; overrunning it is what gets keys banned.
API_SPORTS_KEY=

# football-data.org — https://www.football-data.org/
# Free tier: 10 requests/minute over 13 competitions  ->  we stop at 9/minute.
FOOTBALL_DATA_API_KEY=

# TheSportsDB — https://www.thesportsdb.com/
# "3" is the public free test key (no signup). It rate-limits gently but
# TRUNCATES list responses to a handful of rows. A Patreon key returns full
# lists with no other change. Leave blank to use the free key.
THESPORTSDB_KEY=

# openfootball — https://openfootball.github.io/   needs NO key at all.

# --- optional overrides ---------------------------------------------------
# Raise/lower the daily tier limit the 90% cap is computed from (e.g. after
# upgrading API-Football to Pro, set this to 7500).
# API_SPORTS_DAILY_LIMIT=100
# FOOTBALL_DATA_DAILY_LIMIT=

# Kill switch: 1 = no HTTP request may leave the machine. The test suite sets
# this so tests can never touch a live API or spend quota.
# WINSCOPE_OFFLINE=0

# Not wired up yet — kept for the odds-blend feature.
THE_ODDS_API_KEY=

# --- Turso (libSQL) --------------------------------------------------------
# Where live/upcoming fixtures are published. Finished matches are KEPT in this
# table forever (never deleted) so the model's predictions can be scored against
# real results later. The libsql:// URL Turso shows you is accepted as-is.
# Falls back to TURSO_MATCHES_* / TURSO_DATABASE_URL + TURSO_AUTH_TOKEN, which is
# what web/lib/db.ts already reads, so the Next.js app can share one config.
TURSO_FIXTURES_URL=
TURSO_FIXTURES_TOKEN=
