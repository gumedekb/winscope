# ---- WinScope web (copy to .env.local) ----

# ---------------------------------------------------------------------------
# Turso — the ONE database this app reads.
# `fixtures` is written by the data/ ETL (live + upcoming + finished matches).
# `predictions` is written by this app and joined to it on match_key.
# The libsql:// URL Turso shows you is accepted as-is.
# ---------------------------------------------------------------------------
TURSO_FIXTURES_URL=
TURSO_FIXTURES_TOKEN=

# Optional: only if you later split the logical DBs onto separate Turso databases.
# Anything left blank falls back to TURSO_FIXTURES_URL/_TOKEN above.
# TURSO_MATCHES_URL=
# TURSO_PREDICTIONS_URL=
# TURSO_PREDICTED_URL=
# TURSO_HISTORY_URL=
# TURSO_AUTH_TOKEN=

# Model server (FastAPI on Render). Local dev default below.
MODEL_SERVER_URL=http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# AI insights — ON DEMAND ONLY, and cached in Turso (`ai_insights` table).
# Nothing is generated while listing fixtures; only the "AI Insight" button on a
# single match calls a provider, and re-opening that match reads the cache.
# Gemini is tried first, OpenRouter is the fallback. Either alone is enough.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Optional overrides:
# GEMINI_MODEL=gemini-2.5-flash
# OpenRouter free slugs are retired often, so this is a comma-separated list
# tried in order.
# OPENROUTER_MODELS=minimax/minimax-m3:free,nvidia/nemotron-3.5-lightning:free

# ---------------------------------------------------------------------------
# Odds (optional). The ONLY external API this app is allowed to call.
# Football fixtures/results are NOT fetched here — the data/ ETL owns that, and
# it caps every provider at 90% of its free tier. Calling those APIs from the
# web app too would bypass that cap and risk the key being banned.
# ---------------------------------------------------------------------------
THE_ODDS_API_KEY=
ODDS_SPORT_KEY=soccer_epl
ODDS_MODEL_WEIGHT=0.35
