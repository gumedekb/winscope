# ---------------------------------------------------------------------------
# web/ — the Next.js app. See the root .gitignore for secrets and OS junk.
# ---------------------------------------------------------------------------

# --- dependencies ----------------------------------------------------------
node_modules/
.pnp
.pnp.*
.yarn/

# --- build output ----------------------------------------------------------
# 124 MB locally. Vercel/Render rebuild this from source on every deploy.
.next/
out/
build/
dist/
next-env.d.ts
tsconfig.tsbuildinfo

# --- local env -------------------------------------------------------------
# .env.local holds the live Turso token plus the Gemini/OpenRouter keys.
# .env.example is the tracked template.
.env
.env.local
.env.development.local
.env.production.local
.env.test.local
!.env.example

# --- tooling / caches ------------------------------------------------------
.vercel
.turbo
.eslintcache
coverage/
playwright-report/
test-results/

# --- logs ------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
